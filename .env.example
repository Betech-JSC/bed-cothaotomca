# ==============================================================================
# CÔ THẢO TÔM CÁ - FRONTEND STOREFRONT CONFIGURATION (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CẤU HÌNH ENDPOINT API & DOMAIN CHÍNH (BẮT BUỘC)
# ------------------------------------------------------------------------------

# [BẮT BUỘC] Endpoint API Backend Laravel (Bao gồm tiền tố /api/v1, không có dấu gạch chéo cuối)
# Local: http://127.0.0.1:8000/api/v1 | Staging/Prod: https://cms.cothaotomca.vn/api/v1
NEXT_PUBLIC_API_URL=https://cms.cothaotomca.vn/api/v1

# [TÙY CHỌN] Endpoint API nội bộ dành riêng cho Server-Side Rendering (SSR / Docker internal network)
NEXT_SERVER_API_URL=https://cms.cothaotomca.vn/api/v1

# [BẮT BUỘC] Domain gốc của Website Frontend (Dùng cho SEO Canonical, OpenGraph, Sitemap)
# Local: http://localhost:3000 | Production: https://cothaotomca.vn
NEXT_PUBLIC_BASE_URL=https://cothaotomca.vn
NEXT_PUBLIC_SITE_URL=https://cothaotomca.vn

# ------------------------------------------------------------------------------
# 2. CẤU HÌNH BẢO MẬT, THANH TOÁN & BUILD
# ------------------------------------------------------------------------------

# [BẢO MẬT] Bật tính năng nút Giả lập thanh toán VietQR (Chỉ dùng cho Local/Dev/Testing, BẮT BUỘC false trên Production)
NEXT_PUBLIC_ENABLE_DEV_PAYMENT=false

# [TÙY CHỌN] Mật khẩu bảo vệ cổng truy cập cho môi trường Staging/UAT (PasswordGate - Để trống nếu public tự do)
NEXT_PUBLIC_SITE_PASSWORD=

# [BẢO MẬT] Mã bí mật xác thực webhook revalidate On-Demand ISR từ CMS Backend (Khớp với cấu hình Backend)
REVALIDATION_SECRET=your-secure-revalidation-secret-token

# [BUILD] Thư mục output build Next.js (Mặc định: .next)
BUILD_DIR=.next

# [TEST/E2E] Thư mục lưu bằng chứng kiểm thử tự động Playwright (e2e/mobile-overflow.spec.ts)
EVIDENCE_DIR=./evidence

# ------------------------------------------------------------------------------
# 3. DỊCH VỤ TÍCH HỢP BÊN THỨ BA (MAPS & OAUTH)
# ------------------------------------------------------------------------------

# [TÍCH HỢP] Goong Map API Key cho tính năng gợi ý địa chỉ & tính cước vận chuyển theo khoảng cách
NEXT_PUBLIC_GOONG_API_KEY=your-goong-map-api-key

# [TÍCH HỢP] Google OAuth Client ID cho tính năng Đăng nhập Web Khách hàng (Client-side)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# 4. CẤU HÌNH NEXTAUTH & SOCIAL OAUTH MỞ RỘNG (DỰ PHÒNG / CHUẨN HÓA BÀN GIAO)
# ------------------------------------------------------------------------------

# URL callback cho NextAuth (nếu kích hoạt xác thực qua NextAuth route)
NEXTAUTH_URL=http://localhost:3000

# Khóa bí mật mã hóa session/JWT của NextAuth (Tạo bằng: openssl rand -base64 32)
NEXTAUTH_SECRET=your-nextauth-secret-key

# Thông tin ứng dụng OAuth Google & Facebook (Server-side / NextAuth)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
FACEBOOK_CLIENT_ID=your-facebook-app-id
FACEBOOK_CLIENT_SECRET=your-facebook-app-secret
